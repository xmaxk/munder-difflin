# Supply-chain baseline (sandboxing plan, Phase 1).
# Exact pins on every save — no silent semver drift between lockfile updates.
save-exact=true
# pnpm >=10.16: refuse registry versions younger than 7 days (10080 minutes).
# Compromised releases are typically yanked within days; the cooldown means we
# never install one in its dangerous window. Ignored by npm and older pnpm.
minimum-release-age=10080
